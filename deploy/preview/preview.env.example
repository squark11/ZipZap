# Podgląd app.dowózka.pl — zmienne OSOBNEJ usługi API (np. Render „dowozka-api-preview") z OSOBNĄ bazą.
# Same placeholdery — realne wartości wpisuj tylko w ustawieniach usługi (nigdy do repozytorium).
# Kolejność: 1) baza podglądu, 2) deploy/preview/bootstrap-admin.ps1 (konto admina), 3) te zmienne, 4) start usługi.

ASPNETCORE_ENVIRONMENT=Development

# Tryb publiczny (hartowany): bez Swaggera i mocka płatności, CORS tylko z listy, limiter zawsze włączony.
PILOT__PUBLIC=true
PILOT__PAYMENTMODE=test
# Ustaw dopiero PO założeniu administratora z silnym hasłem (krok 2) — bez tego API nie wystartuje.
PILOT__ADMINPASSWORDCONFIRMED=true

# OSOBNA baza podglądu (np. nowa baza/gałąź w Neon). NIE produkcyjna. Hasło inne niż domyślne.
CONNECTIONSTRINGS__POSTGRES=Host=<host-bazy-podgladu>;Database=<baza-podgladu>;Username=<uzytkownik>;Password=<haslo>;SSL Mode=Require

# Losowy, min. 32 znaki, INNY niż produkcyjny (tokeny podglądu nie mogą działać na produkcji).
JWT__SIGNINGKEY=<losowy-sekret-min-32-znaki>

# Aplikacja podglądu woła API z tej domeny (API samo dopisuje wariant punycode app.xn--dowzka-dxa.pl).
CORS__ALLOWEDORIGINS__0=https://app.dowózka.pl
PUBLICAPP__CUSTOMERAPPURL=https://app.dowózka.pl

# Poczta CELOWO nieustawiona: podgląd ma pocztę-atrapę (aplikacja pokazuje ostrzeżenie, żaden e-mail nie wychodzi).
# Nie ustawiaj EMAIL__HTTP__APIKEY ani EMAIL__SMTP__* — testowy panel nie istnieje, więc linki z e-maili
# (reset hasła, potwierdzenie adresu) nie miałyby dokąd prowadzić. W logu startu będą dwa ostrzeżenia
# (poczta-atrapa, Identity:PublicUrl) — w podglądzie są oczekiwane.

# Health check usługi: /health/ready (nie /health).

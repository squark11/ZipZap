# Skopiuj do .env i uzupełnij (plik .env jest ignorowany przez git).
# Wartości poniżej to DOMYŚLNE wartości developerskie — NIE używaj ich na produkcji.
# Na produkcji ustaw ASPNETCORE_ENVIRONMENT=Production — API odmówi startu z sekretami
# deweloperskimi (guard fail-fast). Szczegóły: PRODUCTION_SETUP.md.

# --- Środowisko ---
ASPNETCORE_ENVIRONMENT=Development

# --- Baza danych (Postgres) ---
POSTGRES_DB=zipzap
POSTGRES_USER=zipzap
POSTGRES_PASSWORD=zipzap

# --- Broker (RabbitMQ) ---
RABBITMQ_USER=zipzap
RABBITMQ_PASSWORD=zipzap

# --- JWT: klucz podpisujący (produkcja: długi, losowy, min. 32 znaki) ---
# Wygeneruj np.: openssl rand -base64 48
JWT__SIGNINGKEY=CHANGE_ME_DEV_ONLY_super_secret_key_at_least_32_chars_long

# --- Płatności ---
# Produkcja: ustaw realnego dostawcę (np. przelewy24) i jego sekrety (patrz docs).
PAYMENTS__PROVIDER=mock
PAYMENTS__MOCK__SECRET=mock-dev-secret
PAYMENTS__PUBLICURL=http://localhost:4200

# --- Identity / linki publiczne (e-mail weryfikacyjny, reset hasła) ---
IDENTITY__PUBLICURL=http://localhost:4200

# --- Logowanie Google (opcjonalne, wymaga konfiguracji OAuth Client ID) ---
GOOGLE__CLIENTID=

# --- Administrator startowy (seed) ---
SEED__ADMINEMAIL=admin@zipzap.local
SEED__ADMINPASSWORD=Admin123!

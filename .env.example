# ZipZap — szablon konfiguracji (skopiuj do `.env` i uzupełnij SWOIMI wartościami).
# `.env` jest w .gitignore — NIGDY nie commituj prawdziwych sekretów.
# Nazewnictwo: podwójny „__" = zagnieżdżenie sekcji (Jwt__SigningKey = Jwt:SigningKey).
# Używane przez docker-compose (usługa `api`) i lokalny backend.

# ---------- Środowisko ----------
ASPNETCORE_ENVIRONMENT=Production          # Production włącza fail-fast na dev-owe sekrety
# ASPNETCORE_URLS=http://+:8080            # w Dockerze ustawione; lokalnie profil http = :5080

# ---------- Baza danych (PostgreSQL) ----------
# Docker: poniższe tworzą kontener. Hosting (Neon/Supabase/Railway): użyj ConnectionStrings__Postgres.
POSTGRES_DB=zipzap
POSTGRES_USER=zipzap
POSTGRES_PASSWORD=CHANGE_ME_silne_haslo_bazy
# ConnectionStrings__Postgres=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>;SSL Mode=Require

# ---------- JWT (podpisywanie tokenów) ----------
# WYMAGANE w prod: min. 32 znaki, losowe. Wygeneruj np.: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_losowy_klucz_min_32_znaki________________
# Jwt__Issuer=zipzap
# Jwt__Audience=zipzap-clients

# ---------- Konto administratora (seed przy pierwszym starcie) ----------
Seed__AdminEmail=admin@twojadomena.pl
Seed__AdminPassword=CHANGE_ME_silne_haslo_admina

# ---------- Płatności ----------
# provider: `mock` (dev) albo docelowy adapter (np. `przelewy24`) po jego dodaniu.
Payments__Provider=mock
Payments__PublicUrl=https://twojadomena.pl        # bazowy URL powrotu/strony płatności
# --- MOCK (tylko dev) ---
Payments__Mock__Secret=CHANGE_ME_sekret_webhooka_mocka
# Payments__Mock__PayPageUrl=https://api.twojadomena.pl/api/payments/mock/pay
# --- REAL: Przelewy24 (uzupełnij po podpięciu adaptera — Twoje konto P24) ---
# Payments__Przelewy24__MerchantId=
# Payments__Przelewy24__PosId=
# Payments__Przelewy24__CrcKey=
# Payments__Przelewy24__ApiKey=
# Payments__Przelewy24__Sandbox=true

# ---------- Logowanie Google (opcjonalne) ----------
# Twoje OAuth Client ID z Google Cloud Console (ekran zgody + Web client).
Google__ClientId=

# ---------- E-mail (opcjonalne; teraz mock logujący) ----------
# Po dodaniu realnego sendera SMTP/dostawcy — Twoje konto poczty:
# Email__Smtp__Host=
# Email__Smtp__Port=587
# Email__Smtp__User=
# Email__Smtp__Password=
# Email__From=no-reply@twojadomena.pl

# ---------- RabbitMQ (opcjonalne; puste = magistrala in-process) ----------
# RabbitMq__Host=
# RABBITMQ_USER=zipzap
# RABBITMQ_PASSWORD=CHANGE_ME

# ---------- Aplikacja web (PWA) ----------
# URL API, do którego łączy się zbudowana aplikacja (build-arg / --dart-define).
WEB_API_BASE_URL=https://api.twojadomena.pl/api

# ---------- Hosting / CI (Twoje konta — trzymaj jako sekrety CI, nie tutaj) ----------
# Cloudflare Pages / Netlify (web):   CLOUDFLARE_API_TOKEN=  /  NETLIFY_AUTH_TOKEN=
# Fly.io / Render / Railway (backend): FLY_API_TOKEN=  /  RENDER_API_KEY=
# Neon / Supabase (DB):               DATABASE_URL=

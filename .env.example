# Skopiuj do .env i uzupełnij (plik .env jest ignorowany przez git).
# Wartości poniżej to DOMYŚLNE wartości developerskie — NIE używaj ich na produkcji.
# Na produkcji ustaw ASPNETCORE_ENVIRONMENT=Production — API odmówi startu z sekretami
# deweloperskimi (guard fail-fast). Szczegóły: PRODUCTION_SETUP.md.
# Nazwy zmiennych są zgodne z docker-compose (${...}); „__" = zagnieżdżenie sekcji.

# --- Środowisko ---
ASPNETCORE_ENVIRONMENT=Development

# --- Baza danych (Postgres) ---
# Hosting (Neon/Supabase/Railway): zamiast POSTGRES_* podaj CONNECTIONSTRINGS__POSTGRES.
POSTGRES_DB=zipzap
POSTGRES_USER=zipzap
POSTGRES_PASSWORD=zipzap
# CONNECTIONSTRINGS__POSTGRES=Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>;SSL Mode=Require

# --- Broker (RabbitMQ) ---
RABBITMQ_USER=zipzap
RABBITMQ_PASSWORD=zipzap

# --- JWT: klucz podpisujący (produkcja: długi, losowy, min. 32 znaki) ---
# Wygeneruj np.: openssl rand -base64 48
JWT__SIGNINGKEY=CHANGE_ME_DEV_ONLY_super_secret_key_at_least_32_chars_long

# --- Płatności ---
# Produkcja: ustaw realnego dostawcę (np. przelewy24) i jego sekrety (patrz docs).
PAYMENTS__PROVIDER=mock
PAYMENTS__MOCK__SECRET=mock-dev-secret
PAYMENTS__PUBLICURL=http://localhost:4200
# PAYMENTS__MOCK__PAYPAGEURL=http://localhost:5080/api/payments/mock/pay
# --- REAL: Przelewy24 (uzupełnij po podpięciu adaptera — Twoje konto P24) ---
# PAYMENTS__PRZELEWY24__MERCHANTID=
# PAYMENTS__PRZELEWY24__POSID=
# PAYMENTS__PRZELEWY24__CRCKEY=
# PAYMENTS__PRZELEWY24__APIKEY=
# PAYMENTS__PRZELEWY24__SANDBOX=true

# --- Identity / linki publiczne (e-mail weryfikacyjny, reset hasła) ---
IDENTITY__PUBLICURL=http://localhost:4200

# --- Logowanie Google (opcjonalne, wymaga konfiguracji OAuth Client ID) ---
GOOGLE__CLIENTID=

# --- E-mail (opcjonalne; teraz mock logujący, realny SMTP po dodaniu sendera) ---
# EMAIL__SMTP__HOST=
# EMAIL__SMTP__PORT=587
# EMAIL__SMTP__USER=
# EMAIL__SMTP__PASSWORD=
# EMAIL__FROM=no-reply@twojadomena.pl

# --- Administrator startowy (seed) ---
SEED__ADMINEMAIL=admin@zipzap.local
SEED__ADMINPASSWORD=Admin123!

# --- Aplikacja web (PWA) ---
# URL API dla zbudowanej aplikacji (build-arg web.Dockerfile / --dart-define=API_BASE_URL).
WEB_API_BASE_URL=http://localhost:5080/api

# --- Hosting / CI (Twoje konta — trzymaj jako SEKRETY CI, nie tutaj) ---
# Cloudflare Pages / Netlify (web):    CLOUDFLARE_API_TOKEN=  /  NETLIFY_AUTH_TOKEN=
# Fly.io / Render / Railway (backend): FLY_API_TOKEN=  /  RENDER_API_KEY=
# Neon / Supabase (DB):                DATABASE_URL=
